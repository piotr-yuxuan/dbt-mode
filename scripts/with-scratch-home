#!/usr/bin/env bash
# SPDX-License-Identifier: EUPL-1.2 OR GPL-3.0-or-later
#
# Usage: scripts/with-scratch-home [--dbt-cache DIRECTORY] COMMAND [ARGUMENT...]
#
# Run COMMAND with a fresh HOME, XDG directories and TMPDIR, so that no
# test reads or writes the user's own: no git configuration but the test
# identity, no Emacs load path from the session, no display, no dbt
# profile.  The marker file .dbt-mode-scratch in HOME tells
# tests/run-ert.el that it runs here.  DIRECTORY, a cache of dbt's
# database drivers such as ~/.cache/com.getdbt, is copied as the scratch
# cache's com.getdbt, where dbt looks for its driver before it downloads
# one; the original stays as it is.  The scratch directory, under /tmp,
# is deleted when COMMAND succeeds, and kept and printed when it fails,
# but for that copy, which is most of its size; so is a run stopped by
# TERM or HUP.

set -uo pipefail

usage="usage: scripts/with-scratch-home [--dbt-cache DIRECTORY] COMMAND [ARGUMENT...]"
cache=
if [[ "${1:-}" == --dbt-cache ]]; then
  cache=${2:-}
  shift 2 || { echo "$usage" >&2; exit 2; }
  if [[ ! -d "$cache" ]]; then
    echo "with-scratch-home: no directory for --dbt-cache: $cache" >&2
    exit 2
  fi
fi
if (( $# == 0 )); then
  echo "$usage" >&2
  exit 2
fi

# An interactive Emacs ignores SIGPIPE, so a write to a process that has
# exited is an error it can handle. A batch Emacs keeps what it inherits,
# and would die of that write, so a test would see what no user can.
trap '' PIPE

# Under /tmp whatever TMPDIR says: nix develop gives each run a TMPDIR
# of its own, /tmp/nix-shell.XXXXXX, which it never removes, so kept
# directories would scatter there; and a relative TMPDIR would make HOME
# relative.
scratch=$(TMPDIR=/tmp mktemp -d -t dbt-mode-scratch.XXXXXX) || exit 2
mkdir -p "$scratch"/{home,config,cache,data,state,tmp}
touch "$scratch/home/.dbt-mode-scratch"

keep() {
  rm -rf -- "$scratch/cache/com.getdbt"
  echo "with-scratch-home: kept $scratch" >&2
}
# A run stopped by a signal, as by a deadline, failed too.  Bash runs
# the trap once COMMAND has returned.
trap 'keep; exit 143' TERM
trap 'keep; exit 129' HUP

if [[ -n "$cache" ]] && ! cp -R -- "$cache/." "$scratch/cache/com.getdbt/"; then
  rm -rf -- "$scratch"
  exit 2
fi

env -u EMACSLOADPATH -u DISPLAY -u WAYLAND_DISPLAY \
  HOME="$scratch/home" \
  XDG_CONFIG_HOME="$scratch/config" \
  XDG_CACHE_HOME="$scratch/cache" \
  XDG_DATA_HOME="$scratch/data" \
  XDG_STATE_HOME="$scratch/state" \
  TMPDIR="$scratch/tmp" \
  GIT_CONFIG_GLOBAL=/dev/null \
  GIT_CONFIG_NOSYSTEM=1 \
  GIT_AUTHOR_NAME=tests GIT_AUTHOR_EMAIL=tests@example.invalid \
  GIT_COMMITTER_NAME=tests GIT_COMMITTER_EMAIL=tests@example.invalid \
  DBT_SEND_ANONYMOUS_USAGE_STATS=false \
  "$@"
status=$?

if (( status == 0 )); then
  rm -rf -- "$scratch"
else
  keep
fi
exit "$status"
